    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "build": {
          "releaseChannel": "default",
          "developmentClient": false,
          "distribution": "store",
          "android": {
            "buildType": "apk"
          }
        },
        "projectId": "a6f2bc1e-caa5-41bc-8bf0-ce7216fbe1e7"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
